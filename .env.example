# ==============================================================================
# PageTurner — Private San Mateo Main Library Family App Configuration
# ==============================================================================
# Paste these variables into Vercel -> Project Settings -> Environment Variables
# (or copy to .env for local use). NEVER commit .env to GitHub!

# Required for private hosting: Family passcode to unlock the app
APP_PASSCODE=your-family-passcode

# Secret string for encrypting session cookies (any 32+ random characters)
ENCRYPTION_SECRET=change-me-to-a-long-random-secret

# Your San Mateo Public Library card (stays 100% private in Vercel Env Vars!)
SMPL_CARD_NAME=Family Card
SMPL_SHELF_NAME=YOUR_LAST_NAME
SMPL_CARD_NUMBER=2904...
SMPL_PIN=1234

# Your private Google Sheet (acts as your $0/mo cloud database!)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/.../edit
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Optional: Secret token Vercel automatically sends to authorize the Monthly Scout cron
# CRON_SECRET=any-random-string
