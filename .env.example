# ==============================================================================
# PageTurner — Private San Mateo Public Library Family App Configuration
# ==============================================================================
# Copy this file to .env for local use, OR paste these variables into your
# private cloud host (Render, Railway, Fly.io). NEVER commit .env to GitHub!

# Port the web server listens on (most cloud hosts set this automatically)
PORT=3000

# Optional: Set a private family passcode so only your family can open the app.
# Leave blank if testing locally without a passcode gate.
APP_PASSCODE=

# Secret key used to encrypt library card PINs at rest & sign session cookies.
# Generate a random 32+ character string when deploying to the cloud!
# Example: openssl rand -hex 32
ENCRYPTION_SECRET=change-me-to-a-long-random-secret

# Optional: Pre-configure your San Mateo Public Library card(s) via env vars
# instead of entering them in the Settings UI.
# SMPL_CARD_NAME="Family Card"
# SMPL_SHELF_NAME="SMITH"
# SMPL_CARD_NUMBER="2904..."
# SMPL_PIN="1234"
# SMPL_DEFAULT_BRANCH="main"

# Optional: Background auto-sync interval in minutes (default: 30, 0 to disable)
SYNC_INTERVAL_MINUTES=30

# Optional: Pre-connect your private Family Book Log Google Sheet
# GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/..."
# GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"
